      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "从已实现按钮样式提取，支持悬停、键盘焦点、按下及禁用状态。",
      "html": "<button class=\"ds-primary\">带走灵感</button>",
      "css": ".ds-primary{font:13px/1.6 var(--font,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);display:inline-flex;align-items:center;gap:9px;border:0;cursor:pointer;background:var(--purple,#5b426b);color:#fff;padding:11px 17px;border-radius:10px;transition:background .18s,color .18s,transform .2s var(--ease,cubic-bezier(.16,1,.3,1));}.ds-primary:hover:not(:disabled){filter:brightness(.97)}.ds-primary:focus-visible{outline:3px solid var(--focus-ring,#a385b8);outline-offset:4px;}.ds-primary:active:not(:disabled){transform:translateY(1px)}.ds-primary:disabled{cursor:wait;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Soft return",
      "kind": "button",
      "refersTo": "button-soft",
      "description": "从已实现按钮样式提取，支持悬停、键盘焦点、按下及禁用状态。",
      "html": "<button class=\"ds-soft\">回到创作现场</button>",
      "css": ".ds-soft{font:13px/1.6 var(--font,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);display:inline-flex;align-items:center;gap:9px;border:0;cursor:pointer;background:var(--lavender,#eee6f5);color:var(--purple,#5b426b);padding:11px 17px;border-radius:9px;transition:background .18s,color .18s,transform .2s var(--ease,cubic-bezier(.16,1,.3,1));}.ds-soft:hover:not(:disabled){filter:brightness(.97)}.ds-soft:focus-visible{outline:3px solid var(--focus-ring,#a385b8);outline-offset:4px;}.ds-soft:active:not(:disabled){transform:translateY(1px)}.ds-soft:disabled{cursor:wait;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-soft{transition:none}}"
    },
    {
      "name": "Quiet action",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "从已实现按钮样式提取，支持悬停、键盘焦点、按下及禁用状态。",
