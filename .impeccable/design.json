      "css": ".ds-quiet{font:13px/1.6 var(--font,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);display:inline-flex;align-items:center;gap:9px;border:0;cursor:pointer;background:transparent;color:var(--ink,#39313d);padding:8px;border-radius:0;transition:background .18s,color .18s,transform .2s var(--ease,cubic-bezier(.16,1,.3,1));}.ds-quiet:hover:not(:disabled){filter:brightness(.97)}.ds-quiet:focus-visible{outline:3px solid var(--focus-ring,#a385b8);outline-offset:4px;}.ds-quiet:active:not(:disabled){transform:translateY(1px)}.ds-quiet:disabled{cursor:wait;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-quiet{transition:none}}"
    },
    {
      "name": "Prompt note",
      "kind": "input",
      "refersTo": "prompt-form",
      "description": "便签式输入；容器承担聚焦状态，发送按钮保留独立焦点。",
      "html": "<form class=\"ds-prompt\"><label class=\"ds-prompt-label\" for=\"ds-idea\">你的创作想法</label><textarea id=\"ds-idea\" class=\"ds-textarea\" rows=\"3\" maxlength=\"240\" placeholder=\"说点什么，没想清楚也可以…\"></textarea><div class=\"ds-input-footer\"><span>改主意，也是一种进展</span><button class=\"ds-send\" type=\"button\" aria-label=\"发送想法\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 19V5M6 11l6-6 6 6\"/></svg></button></div></form>",
      "css": ".ds-prompt{width:280px;max-width:100%;border:1px solid #c9b9d1;padding:12px 12px 9px;border-radius:13px;background:var(--white,#fffefb);transition:box-shadow .2s}.ds-prompt:focus-within{box-shadow:0 2px 14px #694b7f13;border-color:#8c6b9e}.ds-prompt-label{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.ds-textarea{font:12px/1.8 var(--font,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);width:100%;border:0;outline:none;resize:vertical;min-height:57px;max-height:180px;background:transparent;color:var(--ink,#39313d);caret-color:var(--purple,#5b426b)}.ds-textarea::placeholder{color:#746878}.ds-input-footer{display:flex;align-items:center;justify-content:space-between;font:9px/1.6 var(--font,\"PingFang SC\",\"Microsoft YaHei\",sans-serif);color:#776c79;padding-top:2px}.ds-send{display:grid;place-items:center;width:29px;height:29px;border:0;border-radius:50%;background:var(--purple,#5b426b);color:white;cursor:pointer}.ds-send svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-send:hover{filter:brightness(.97)}.ds-send:focus-visible{outline:3px solid var(--focus-ring,#a385b8);outline-offset:4px;}.ds-send:active{transform:translateY(1px)}.ds-send:disabled{opacity:.5;cursor:wait}@media(prefers-reduced-motion:reduce){.ds-prompt{transition:none}}"
    },
